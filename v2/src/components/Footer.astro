---
import Container from "./Container.astro";
import { FOOTER, MAILTO, SITE, pick } from "../lib/site";

const year = new Date().getFullYear();
const socials = [
  { href: SITE.linkedin.url, label: SITE.linkedin.label },
  { href: SITE.github.url, label: SITE.github.label },
  { href: MAILTO, label: "Email" },
];
---

<footer
  class="mt-(--spacing-section) border-t border-[color-mix(in_oklab,var(--text)_8%,transparent)]"
>
  <Container size="wide" class="py-12 grid gap-10 sm:grid-cols-3 lg:grid-cols-5 items-start">
    <div>
      <p class="font-display text-2xl tracking-[-0.01em]">
        {SITE.name}
      </p>
      <p class="mt-2 text-sm" style="color: var(--text-soft)">
        {SITE.location} · Junior Software Engineer at VMotion IT Solutions.
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow mb-3">Pages</p>
      <ul class="space-y-0.5 text-sm">
        {pick(FOOTER.pages).map((r) => (
          <li><a href={r.href} class="hover:text-(--accent) transition-colors inline-block py-1">{r.footerLabel ?? r.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Trades">
      <p class="eyebrow mb-3">Three trades</p>
      <ul class="space-y-0.5 text-sm">
        {pick(FOOTER.trades).map((r) => (
          <li><a href={r.href} class="hover:text-(--accent) transition-colors inline-block py-1">{r.footerLabel ?? r.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Explore">
      <p class="eyebrow mb-3">Explore</p>
      <ul class="space-y-0.5 text-sm">
        {pick(FOOTER.explore).map((r) => (
          <li><a href={r.href} class="hover:text-(--accent) transition-colors inline-block py-1">{r.footerLabel ?? r.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="eyebrow mb-3">Find me</p>
      <ul class="space-y-0.5 text-sm">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="hover:text-(--accent) transition-colors inline-block py-1"
            >
              {s.label} →
            </a>
          </li>
        ))}
        <li>
          <a
            href="/cv/"
            class="hover:text-(--accent) transition-colors inline-block py-1"
          >
            Curriculum Vitae →
          </a>
        </li>
      </ul>
    </div>
  </Container>

  <Container size="wide" class="pb-10 pt-2">
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs"
      style="color: var(--text-soft)"
    >
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>
        Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-(--accent) transition-colors inline-block py-1">Astro</a
        >
        & <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-(--accent) transition-colors inline-block py-1">Tailwind</a
        >.
      </p>
    </div>
  </Container>
</footer>
