---
/**
 * <Picture> — serves responsive WebP with a JPG/PNG fallback.
 *
 * Pass the original asset filename relative to public/assets/ (e.g.
 * "profile pic.jpg" or "cellar-hero/red.jpg"); an absolute "/assets/..." path
 * is also accepted. `scripts/optimize-images.mjs` writes
 * src/data/image-manifest.json (original dimensions, WebP path and the 640 px
 * variant). From it the component emits:
 *
 *   <picture>
 *     <source type="image/webp" srcset="<name>-640.webp 640w, <name>.webp NNNNw" sizes="…">
 *     <img src="<original>" width height …>
 *   </picture>
 *
 * Every URL is percent-encoded (filenames contain spaces). `sizes` defaults to
 * "100vw" — pass a real value for anything narrower than the viewport so the
 * browser can choose the 640 px variant. width/height come from the manifest
 * unless overridden. Images without a manifest entry fall back to a plain
 * (encoded) WebP source / original.
 *
 * Run `npm run optimize:images` to (re)generate the variants and manifest.
 */
import manifest from "../data/image-manifest.json";

interface Props {
  src: string; // e.g. "profile pic.jpg" — original filename under public/assets/
  alt: string;
  class?: string;
  width?: number | string;
  height?: number | string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
}

const {
  src,
  alt,
  class: className = "",
  width,
  height,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  sizes = "100vw",
} = Astro.props;

const key = src.replace(/^\/?assets\//, "").replace(/^\//, "");
const url = (p: string) =>
  "/assets/" + p.split("/").map(encodeURIComponent).join("/");

type Entry = {
  width: number;
  height: number;
  webp: string | null;
  webpWidth: number;
  variants: { src: string; width: number }[];
};
const entry = (manifest as Record<string, Entry>)[key];

const lastDot = key.lastIndexOf(".");
const base = lastDot === -1 ? key : key.slice(0, lastDot);
const isWebpOriginal = key.toLowerCase().endsWith(".webp");

let webpSrcset: string | undefined;
if (entry) {
  if (entry.webp && !isWebpOriginal) {
    webpSrcset = [
      ...entry.variants.map((v) => `${url(v.src)} ${v.width}w`),
      `${url(entry.webp)} ${entry.webpWidth}w`,
    ].join(", ");
  }
} else if (!isWebpOriginal) {
  webpSrcset = url(`${base}.webp`);
}

const imgWidth = width ?? entry?.width;
const imgHeight = height ?? entry?.height;
---

{
  webpSrcset ? (
    <picture>
      <source srcset={webpSrcset} type="image/webp" sizes={sizes} />
      <img
        src={url(key)}
        alt={alt}
        class={className}
        width={imgWidth}
        height={imgHeight}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    </picture>
  ) : (
    <img
      src={url(key)}
      alt={alt}
      class={className}
      width={imgWidth}
      height={imgHeight}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  )
}
