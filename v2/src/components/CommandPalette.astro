---
/**
 * Command palette shell — Ctrl+K / ⌘K, or click any [data-palette-open]
 * element. The result list is rendered client-side from /search-index.json
 * on first open (src/scripts/command-palette.ts), so no index data is
 * inlined into the page.
 */
---

<dialog
  id="cmdk-dialog"
  class="m-0 p-0 max-w-none w-full h-full bg-transparent backdrop:bg-black/60 backdrop:backdrop-blur-md"
  aria-label="Command palette"
>
  <div class="min-h-full flex items-start justify-center pt-[8vh] px-4 pb-4">
    <div
      class="w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col"
      style="
        max-height: 76vh;
        background: var(--bg);
        border: 1px solid var(--field-border, color-mix(in oklab, var(--text) 12%, transparent));
        color: var(--text);
      "
    >
      <div
        class="flex items-center gap-3 px-5 py-4 border-b"
        style="border-color: color-mix(in oklab, var(--text) 10%, transparent);"
      >
        <span aria-hidden="true" class="text-lg" style="color: var(--accent);">⌕</span>
        <input
          id="cmdk-input"
          type="search"
          placeholder="Search pages, roles, wines, phrases…"
          autocomplete="off"
          spellcheck="false"
          class="flex-1 bg-transparent border-0 focus:outline-none text-base"
          style="color: var(--text);"
          aria-label="Search the site"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="cmdk-list"
        />
        <button
          type="button"
          class="shrink-0 px-2 py-0.5 rounded text-[0.7rem] font-mono"
          style="background: color-mix(in oklab, var(--text) 8%, transparent); color: var(--text-soft);"
          onclick="document.getElementById('cmdk-dialog').close()"
          aria-label="Close search"
        >ESC</button>
      </div>

      <div id="cmdk-list" class="overflow-y-auto flex-1" role="listbox" aria-label="Search results"></div>

      <p id="cmdk-message" class="px-5 py-10 text-center text-sm" style="color: var(--text-soft);" hidden></p>
      <div id="cmdk-status" class="sr-only" role="status" aria-live="polite"></div>

      <div
        class="px-5 py-3 border-t flex items-center justify-between gap-3 text-[0.7rem]"
        style="
          border-color: color-mix(in oklab, var(--text) 10%, transparent);
          color: var(--text-soft);
          background: color-mix(in oklab, var(--text) 3%, transparent);
        "
      >
        <span class="flex items-center gap-2">
          <kbd class="px-1.5 py-0.5 rounded font-mono" style="background: color-mix(in oklab, var(--text) 10%, transparent);">↑↓</kbd>
          to navigate
        </span>
        <span class="flex items-center gap-2">
          <kbd class="px-1.5 py-0.5 rounded font-mono" style="background: color-mix(in oklab, var(--text) 10%, transparent);">↵</kbd>
          to open
        </span>
        <span class="hidden sm:flex items-center gap-2">
          <kbd class="px-1.5 py-0.5 rounded font-mono" data-palette-shortcut style="background: color-mix(in oklab, var(--text) 10%, transparent);">Ctrl K</kbd>
          to toggle
        </span>
      </div>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/command-palette";
</script>

<style is:global>
  #cmdk-list .cmdk-group {
    padding: 0.6rem 1.25rem 0.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  #cmdk-list .cmdk-option {
    padding: 0.55rem 1.25rem;
    cursor: pointer;
    color: var(--text);
  }
  #cmdk-list .cmdk-option[aria-selected="true"] {
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  #cmdk-list .cmdk-title {
    font-size: 0.875rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #cmdk-list .cmdk-note {
    font-size: 0.75rem;
    color: var(--text-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #cmdk-list .cmdk-mark {
    background: color-mix(in oklab, var(--accent) 35%, transparent);
    color: var(--text);
    border-radius: 2px;
  }
</style>
