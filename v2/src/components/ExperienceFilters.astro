---
interface Props {
  categories: { id: string; label: string; count: number }[];
  highlightCount: number;
}

const { categories, highlightCount } = Astro.props;
const total = categories.reduce((sum, c) => sum + c.count, 0);
---

<div
  id="exp-filters"
  class="sticky top-[4.25rem] z-30 -mx-5 sm:-mx-8 lg:-mx-10 px-5 sm:px-8 lg:px-10 py-4 mb-10 backdrop-blur-md border-y"
  style="background: color-mix(in oklab, var(--bg) 88%, transparent); border-color: color-mix(in oklab, var(--text) 8%, transparent);"
>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
    <!-- Search -->
    <div class="relative lg:max-w-xs lg:flex-1">
      <label for="exp-search" class="sr-only">Search experience</label>
      <span
        aria-hidden="true"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-sm"
        style="color:var(--text-soft)"
      >⌕</span>
      <input
        type="search"
        id="exp-search"
        placeholder="Search roles, employers, keywords..."
        autocomplete="off"
        class="w-full pl-10 pr-3 py-2.5 text-sm rounded-full border bg-transparent transition-colors"
        style="border-color: var(--field-border, color-mix(in oklab, var(--text) 45%, transparent)); color: var(--text);"
      />
    </div>

    <!-- Category filters -->
    <div class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-end" role="group" aria-label="Filter by category">
      <button
        type="button"
        class="exp-cat-btn inline-flex items-center min-h-10 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase border transition-all"
        data-category="highlights"
        aria-pressed="false"
        style="border-color: var(--field-border, color-mix(in oklab, var(--text) 45%, transparent)); color: var(--text-soft);"
      >
        Highlights <span class="font-mono ml-1">{highlightCount}</span>
      </button>
      <button
        type="button"
        aria-pressed="true"
        class="exp-cat-btn active inline-flex items-center min-h-10 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase border transition-all"
        data-category="all"
        style="border-color: var(--accent); background: var(--accent); color: var(--on-accent, #FAF6F0);"
      >
        All <span class="font-mono ml-1">{total}</span>
      </button>
      {categories.map((cat) => (
        <button
          type="button"
          class="exp-cat-btn inline-flex items-center min-h-10 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase border transition-all"
          data-category={cat.id}
          aria-pressed="false"
          style="border-color: var(--field-border, color-mix(in oklab, var(--text) 45%, transparent)); color: var(--text-soft);"
        >
          {cat.label} <span class="font-mono ml-1" style="color: var(--text-soft);">{cat.count}</span>
        </button>
      ))}
    </div>
  </div>

  <p id="exp-count" role="status" aria-live="polite" class="text-xs mt-3 lg:text-right" style="color:var(--text-soft)"></p>
  <p
    id="exp-empty-state"
    hidden
    role="status"
    class="text-sm mt-3 text-center"
    style="color:var(--text-soft)"
  >
    No roles match — try a different keyword or category.
  </p>
</div>

<style>
  .exp-cat-btn:not(.active):hover { border-color: var(--accent) !important; color: var(--accent) !important; }
</style>

<style is:global>
  /* The script opens on "Highlights". Hide the other roles from first paint
     (JS on only, before the script takes over) so the list doesn't jump. */
  html.js:not(.exp-ready) .experience-item[data-featured="false"],
  html.js:not(.exp-ready) [data-year-group]:not(:has(.experience-item[data-featured="true"])) {
    display: none;
  }
  /* Entries reached from the timeline chart must clear the sticky header + filter bar (set by the script). */
  .experience-item {
    scroll-margin-top: var(--exp-scroll-margin, 12rem);
  }
  /* The filter controls need JS; without it they would only cover entries as a sticky bar. */
  html:not(.js) #exp-filters {
    display: none;
  }
</style>

<script>
  import { initChipGroup } from "../scripts/filter-chips";

  const search = document.getElementById("exp-search") as HTMLInputElement | null;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".exp-cat-btn"));
  const items = document.querySelectorAll<HTMLDetailsElement>(".experience-item");
  const yearGroups = document.querySelectorAll<HTMLElement>("[data-year-group]");
  const empty = document.getElementById("exp-empty-state");
  const countEl = document.getElementById("exp-count");

  // Without JS every entry stays visible; the default view is only applied here.
  let activeCategory = "highlights";
  let activeQuery = "";

  function matchesCategory(item: HTMLElement, cat: string) {
    if (cat === "all") return true;
    if (cat === "highlights") return item.dataset.featured === "true";
    return item.dataset.category === cat;
  }

  function apply() {
    let visibleCount = 0;

    items.forEach((item) => {
      const hay = item.dataset.search ?? "";
      const visible =
        matchesCategory(item, activeCategory) && (!activeQuery || hay.includes(activeQuery));
      item.hidden = !visible;
      if (visible) visibleCount++;
    });

    yearGroups.forEach((group) => {
      group.hidden = group.querySelectorAll(".experience-item:not([hidden])").length === 0;
    });

    if (empty) empty.hidden = visibleCount > 0;
    if (countEl) {
      countEl.textContent = visibleCount
        ? `Showing ${visibleCount} of ${items.length} roles`
        : "";
    }
  }

  const chips = initChipGroup(buttons, {
    activeStyle: {
      "border-color": "var(--accent)",
      background: "var(--accent)",
      color: "var(--on-accent, #FAF6F0)",
    },
    inactiveStyle: {
      "border-color": "var(--field-border, color-mix(in oklab, var(--text) 45%, transparent))",
      background: "transparent",
      color: "var(--text-soft)",
    },
    onChange(btn) {
      activeCategory = btn.dataset.category ?? "all";
      apply();
    },
  });

  function selectCategory(cat: string) {
    const btn = buttons.find((b) => b.dataset.category === cat);
    if (!btn) return;
    activeCategory = cat;
    chips.select(btn);
  }

  search?.addEventListener("input", () => {
    activeQuery = search.value.trim().toLowerCase();
    // Searching spans every role, so reflect that in the chip state.
    if (activeQuery && activeCategory !== "all") selectCategory("all");
    apply();
  });

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const siteHeader = document.getElementById("site-nav");
  const filterBar = document.getElementById("exp-filters");

  /** Keep a jumped-to entry clear of the sticky site header and the sticky filter bar. */
  function updateScrollMargin() {
    const need = (siteHeader?.offsetHeight ?? 0) + (filterBar?.offsetHeight ?? 0) + 16;
    const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    document.documentElement.style.setProperty("--exp-scroll-margin", `${Math.max(0, need - padding)}px`);
  }

  /** Show an entry even if the current filter hides it, open it and scroll it into view. */
  const safeDecode = (s: string) => {
    try {
      return decodeURIComponent(s);
    } catch {
      return s;
    }
  };

  function reveal(id: string, { smooth = true, focus = false }: { smooth?: boolean; focus?: boolean } = {}) {
    const el = id ? document.getElementById(id) : null;
    if (!el || !el.classList.contains("experience-item")) return;
    const item = el as HTMLDetailsElement;
    if (item.hidden) {
      if (search) search.value = "";
      activeQuery = "";
      selectCategory("all");
      apply();
    }
    item.open = true;
    if (focus) item.querySelector<HTMLElement>("summary")?.focus({ preventScroll: true });
    updateScrollMargin();
    requestAnimationFrame(() => {
      item.scrollIntoView({ behavior: smooth && !prefersReduced.matches ? "smooth" : "auto", block: "start" });
    });
  }

  // Open on Highlights. A deep link to a hidden entry switches to "All" (via reveal) below.
  selectCategory("highlights");
  apply();
  // Hand over from the pre-paint CSS (see the <style is:global> above) to the script.
  document.documentElement.classList.add("exp-ready");

  if (location.hash) reveal(safeDecode(location.hash.slice(1)), { smooth: false });

  window.addEventListener("hashchange", () => reveal(safeDecode(location.hash.slice(1)), { focus: true }));

  // Re-clicking a link to the current hash fires no hashchange, so handle in-page links directly.
  document.addEventListener("click", (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element).closest<HTMLAnchorElement>("a[href^=\"#\"]");
    if (!link) return;
    const id = safeDecode(link.getAttribute("href")!.slice(1));
    const el = id ? document.getElementById(id) : null;
    if (!el || !el.classList.contains("experience-item")) return;
    // Capture phase + preventDefault: the site-wide smooth-anchor handler checks defaultPrevented and steps aside,
    // so it cannot scroll to a still-hidden entry. Propagation continues for other listeners.
    e.preventDefault();
    if (location.hash !== `#${id}`) history.pushState(null, "", `#${id}`);
    reveal(id, { focus: true });
  }, true);
</script>
