---
// Theme toggle cycling: auto → light → dark → auto
// The actual `dark` class is applied to <html> by the inline pre-paint script
// in BaseLayout.astro so there's no flash on load.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Theme: Auto (switch to Light)"
  title="Theme: Auto (switch to Light)"
  class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-[color-mix(in_oklab,var(--text)_15%,transparent)] hover:border-(--accent) hover:text-(--accent) transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg)"
>
  <!-- Icons sit in spans: `hidden` only works on HTML elements, not <svg>. -->
  <span data-icon="auto" class="inline-flex"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></span>
  <span data-icon="light" class="inline-flex" hidden><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span>
  <span data-icon="dark" class="inline-flex" hidden><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg></span>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const icons = btn.querySelectorAll("[data-icon]");

    const apply = (theme) => {
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const resolved = theme === "auto" ? (prefersDark ? "dark" : "light") : theme;
      root.classList.toggle("dark", resolved === "dark");
      root.dataset.themePref = theme;
      icons.forEach((el) => { el.hidden = el.getAttribute("data-icon") !== theme; });
      const names = { auto: "Auto", light: "Light", dark: "Dark" };
      const nextName = names[theme === "auto" ? "light" : theme === "light" ? "dark" : "auto"];
      const label = `Theme: ${names[theme]} (switch to ${nextName})`;
      btn.setAttribute("aria-label", label);
      btn.setAttribute("title", label);
    };

    const read = () => {
      try { return localStorage.getItem("theme") || "auto"; } catch (e) { return document.documentElement.dataset.themePref || "auto"; }
    };

    apply(read());

    btn.addEventListener("click", () => {
      const current = read();
      const next =
        current === "auto" ? "light" : current === "light" ? "dark" : "auto";
      try { localStorage.setItem("theme", next); } catch (e) {}
      apply(next);
    });

    // React to system changes while in auto mode
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (read() === "auto") apply("auto");
      });
  })();
</script>
