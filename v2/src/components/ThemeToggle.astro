---
// Theme toggle cycling: auto → light → dark → auto
// The actual `dark` class is applied to <html> by the inline pre-paint script
// in BaseLayout.astro so there's no flash on load.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Theme: Auto (switch to Light)"
  title="Theme: Auto (switch to Light)"
  class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-[color-mix(in_oklab,var(--text)_15%,transparent)] hover:border-(--accent) hover:text-(--accent) transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg)"
>
  <span aria-hidden="true" data-theme-icon class="text-base leading-none"></span>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const icon = btn.querySelector("[data-theme-icon]");

    const apply = (theme) => {
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const resolved = theme === "auto" ? (prefersDark ? "dark" : "light") : theme;
      root.classList.toggle("dark", resolved === "dark");
      root.dataset.themePref = theme;
      if (icon) {
        icon.textContent =
          theme === "auto" ? "◐" : theme === "dark" ? "●" : "○";
      }
      const names = { auto: "Auto", light: "Light", dark: "Dark" };
      const nextName = names[theme === "auto" ? "light" : theme === "light" ? "dark" : "auto"];
      const label = `Theme: ${names[theme]} (switch to ${nextName})`;
      btn.setAttribute("aria-label", label);
      btn.setAttribute("title", label);
    };

    const read = () => {
      try { return localStorage.getItem("theme") || "auto"; } catch (e) { return document.documentElement.dataset.themePref || "auto"; }
    };

    apply(read());

    btn.addEventListener("click", () => {
      const current = read();
      const next =
        current === "auto" ? "light" : current === "light" ? "dark" : "auto";
      try { localStorage.setItem("theme", next); } catch (e) {}
      apply(next);
    });

    // React to system changes while in auto mode
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (read() === "auto") apply("auto");
      });
  })();
</script>
