---
import Container from "./Container.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { NAV, pick, SITE } from "../lib/site";

const primaryLinks = pick(NAV.primary);


const moreLinks = pick(NAV.more);

// Mobile: CV + Contact pinned as buttons, then everything else.
const mobileRest = primaryLinks.filter((l) => l.href !== "/cv/");

// Normalise to a trailing slash so it compares equal to the link hrefs.
const path = Astro.url.pathname.replace(/\/?$/, "/");
const moreActive = moreLinks.some((l) => path === l.href);
const activeCue = "underline decoration-2 underline-offset-[6px]";
---

<header
  id="site-nav"
  class="sticky top-0 z-40 backdrop-blur-md bg-[color-mix(in_oklab,var(--bg)_82%,transparent)] border-b border-[color-mix(in_oklab,var(--text)_8%,transparent)]"
>
  <Container size="wide" class="flex items-center justify-between gap-3 py-4">
    <a
      href="/"
      class="font-display text-xl tracking-[-0.01em] hover:text-(--accent) transition-colors"
      style="color: var(--text)"
    >
      {SITE.name}
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-0.5">
      {primaryLinks.map((link) => {
        const active = path === link.href;
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "px-2.5 py-2 text-sm tracking-wide rounded-full transition-colors hover:text-(--accent)",
              active && activeCue,
            ]}
            style={active ? "color: var(--accent)" : "color: var(--text-soft)"}
          >
            {link.label}
          </a>
        );
      })}

      <!-- More dropdown -->
      <div class="relative" id="more-wrap">
        <button
          id="more-btn"
          type="button"
          aria-expanded="false"
          aria-controls="more-panel"
          class:list={[
            "inline-flex items-center gap-1 px-2.5 py-2 text-sm tracking-wide rounded-full transition-colors select-none hover:text-(--accent)",
            moreActive && activeCue,
          ]}
          style={moreActive ? "color: var(--accent)" : "color: var(--text-soft)"}
        >
          More
          <svg
            id="more-chevron"
            width="10"
            height="7"
            viewBox="0 0 10 7"
            fill="none"
            aria-hidden="true"
            class="transition-transform duration-200"
          >
            <path
              d="M1 1L5 6L9 1"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          id="more-panel"
          hidden
          class="absolute right-0 z-50 w-64 rounded-2xl border overflow-hidden"
          style="top: calc(100% + 6px); background: var(--bg); border-color: color-mix(in oklab, var(--text) 12%, transparent); box-shadow: 0 8px 40px color-mix(in oklab, var(--text) 16%, transparent);"
        >
          {moreLinks.map((link) => {
            const active = path === link.href;
            return (
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between gap-3 px-4 py-3.5 border-b last:border-0 transition-colors group",
                  active
                    ? "bg-[color-mix(in_oklab,var(--accent)_6%,transparent)]"
                    : "hover:bg-[color-mix(in_oklab,var(--text)_4%,transparent)]",
                ]}
                style="border-color: color-mix(in oklab, var(--text) 7%, transparent);"
              >
                <div>
                  <p
                    class:list={["text-sm font-medium leading-snug", active && activeCue]}
                    style={active ? "color: var(--accent)" : "color: var(--text)"}
                  >
                    {link.label}
                  </p>
                  <p class="text-[0.7rem] mt-0.5 leading-snug" style="color: var(--text-soft)">
                    {link.note}
                  </p>
                </div>
                <span
                  class="text-sm flex-shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
                  style="color: var(--text-soft)"
                  aria-hidden="true"
                >→</span>
              </a>
            );
          })}
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Search (opens the command palette) -->
      <button
        type="button"
        data-palette-open
        aria-label="Search the site"
        class="inline-flex items-center justify-center gap-2 h-10 min-w-10 px-0 lg:px-3 rounded-full border border-[color-mix(in_oklab,var(--text)_15%,transparent)] hover:border-(--accent) hover:text-(--accent) transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
          <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <kbd
          data-palette-hint
          aria-hidden="true"
          class="hidden xl:inline text-[0.7rem] font-sans tracking-wide"
          style="color: var(--text-soft)">Ctrl K</kbd
        >
      </button>

      <a
        href="/contact/"
        aria-current={path === "/contact/" ? "page" : undefined}
        class:list={[
          "hidden lg:inline-flex items-center px-5 py-2 text-sm font-medium tracking-wide rounded-full transition-opacity hover:opacity-90",
          path === "/contact/" && "underline decoration-2 underline-offset-4",
        ]}
        style="background: var(--accent); color: var(--on-accent)"
      >
        Contact
      </a>

      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-[color-mix(in_oklab,var(--text)_15%,transparent)] hover:border-(--accent) hover:text-(--accent) transition-colors"
      >
        <span aria-hidden="true" data-menu-icon>☰</span>
      </button>
    </div>
  </Container>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="lg:hidden border-t border-[color-mix(in_oklab,var(--text)_8%,transparent)] max-h-[calc(100dvh-4.5rem)] overflow-y-auto"
  >
    <Container size="wide" class="py-3">
      <nav aria-label="Mobile" class="flex flex-col">
        <div class="grid grid-cols-2 gap-3 pb-3">
          <a
            href="/cv/"
            aria-current={path === "/cv/" ? "page" : undefined}
            class="inline-flex items-center justify-center rounded-full border border-(--accent) px-4 py-3 text-base font-medium"
            style="color: var(--accent)"
          >
            CV
          </a>
          <a
            href="/contact/"
            aria-current={path === "/contact/" ? "page" : undefined}
            class="inline-flex items-center justify-center rounded-full px-4 py-3 text-base font-medium"
            style="background: var(--accent); color: var(--on-accent)"
          >
            Contact
          </a>
        </div>
        {mobileRest.map((link) => {
          const active = path === link.href;
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "py-3 text-base border-b border-[color-mix(in_oklab,var(--text)_6%,transparent)] hover:text-(--accent) transition-colors",
                active && activeCue,
              ]}
              style={active ? "color: var(--accent)" : "color: var(--text)"}
            >
              {link.label}
            </a>
          );
        })}
        <p
          class="pt-5 pb-2 text-[0.65rem] font-semibold tracking-widest uppercase"
          style="color: var(--text-soft)"
        >
          More
        </p>
        {moreLinks.map((link) => {
          const active = path === link.href;
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "py-3 text-base border-b border-[color-mix(in_oklab,var(--text)_6%,transparent)] last:border-0 hover:text-(--accent) transition-colors",
                active && activeCue,
              ]}
              style={active ? "color: var(--accent)" : "color: var(--text)"}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </Container>
  </div>
</header>

<script is:inline>
  (function () {
    // Platform-appropriate shortcut hint
    if (/Mac|iPhone|iPad/.test(navigator.platform || "")) {
      document.querySelectorAll("[data-palette-hint]").forEach((k) => (k.textContent = "⌘K"));
    }

    // Mobile menu
    const btn = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu) {
      const icon = btn.querySelector("[data-menu-icon]");
      const setOpen = (open) => {
        menu.hidden = !open;
        btn.setAttribute("aria-expanded", String(open));
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        if (icon) icon.textContent = open ? "×" : "☰";
      };
      btn.addEventListener("click", () => setOpen(menu.hidden));
      menu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => setOpen(false)),
      );
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden) {
          setOpen(false);
          btn.focus();
        }
      });
    }

    // More dropdown
    const wrap = document.getElementById("more-wrap");
    const moreBtn = document.getElementById("more-btn");
    const morePanel = document.getElementById("more-panel");
    const moreChevron = document.getElementById("more-chevron");

    if (wrap && moreBtn && morePanel) {
      const setMore = (open) => {
        morePanel.hidden = !open;
        moreBtn.setAttribute("aria-expanded", String(open));
        if (moreChevron) moreChevron.style.transform = open ? "rotate(180deg)" : "";
      };

      moreBtn.addEventListener("click", () => setMore(morePanel.hidden));

      document.addEventListener("click", (e) => {
        if (!wrap.contains(e.target)) setMore(false);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !morePanel.hidden) {
          setMore(false);
          moreBtn.focus();
        }
      });

      wrap.addEventListener("focusout", (e) => {
        if (!morePanel.hidden && e.relatedTarget && !wrap.contains(e.relatedTarget)) setMore(false);
      });

      morePanel.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => setMore(false)),
      );
    }
  })();
</script>
