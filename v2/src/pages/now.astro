---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";

// Update this whenever you want. Date in ISO format.
const lastUpdated = "2026-09-23";

const sections = [
  {
    label: "Working on",
    items: [
      "Graduated BSc Computer Science at UL (2:1 Honours). Now studying MSc AI & Machine Learning at UL.",
      "Junior Software Engineer at VMotion IT Solutions, an Atlassian Gold Solution Partner in Limerick.",
      "Part-time Duty Manager at Aura's Grove Island leisure centre, after finishing up as Duty Manager and Swim Teacher at Askeaton Pool & Leisure.",
      "Student Centre Operations Assistant with UL Student Life, shifts scheduled around the MSc timetable.",
      "Back tutoring in UL's ICT Learning Centre for a third year.",
      "Treasurer of the UL Taekwondo Club.",
    ],
  },
  {
    label: "Learning",
    items: [
      "Working toward the WSET Level 3 in Wines — not booked yet.",
      "Into the MSc coursework now — deep learning, NLP and the rest of the AI/ML core.",
      "Open-water swim drills carried back from the Portugal training camp.",
    ],
  },
  {
    label: "Reading / watching",
    items: [
      "Hugh Johnson Pocket Wine 2024 — Hugh Johnson & Margaret Rand.",
      "Sales and Service for the Wine Professional — Brian K. Julyan.",
      "Influence: The Psychology of Persuasion — Robert B. Cialdini.",
      "The New Sotheby's Wine Encyclopedia — Tom Stevenson.",
      "Taekwon-Do Kicks: Techniques, Strength, and Flexibility, White to Blue Belt — Sally Gleaves.",
    ],
  },
  {
    label: "Drinking",
    items: [
      "Bessa Valley Enira Reserva 2018 — Bulgarian Bordeaux-blend red, from the cellar.",
      "Étienne Calsac L'Échappée Belle Blanc de Blancs — grower Champagne from Avize.",
      "Vinprom Troyan Troyanska Slivova, 25-year-old — oak-aged Bulgarian plum rakia.",
    ],
  },
];

const formattedDate = new Date(lastUpdated).toLocaleDateString("en-IE", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title="Now — Todor Aleksandrov"
  description="What I'm working on, learning, reading, drinking — this month. A living snapshot inspired by Derek Sivers's /now movement."
>
  <Container size="narrow" class="py-(--spacing-section)">
    <p class="eyebrow">Now</p>
    <h1
      class="font-display tracking-[-0.03em] mt-4"
      style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 1.02;"
    >
      What I'm doing
      <em
        class="not-italic block mt-2"
        style="font-style: italic; color: var(--accent);"
      >
        this month.
      </em>
    </h1>
    <p
      class="mt-6 text-lg leading-relaxed"
      style="color: var(--text-soft)"
    >
      A page from <a
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-burgundy-300 underline-offset-4 hover:decoration-burgundy-600 transition-colors">Derek Sivers's <em>/now</em> movement</a>
      — what I'd tell you if we ran into each other today. Updated whenever I notice it's gone stale.
    </p>
    <p class="mt-4 text-sm font-mono" style="color: var(--text-soft)">
      Last updated · {formattedDate}
    </p>

    <hr class="rule mt-10 mb-12" />

    <div class="space-y-10">
      {sections.map((section, i) => (
        <section data-reveal>
          <div class="grid sm:grid-cols-[8rem_1fr] gap-3 sm:gap-8">
            <div>
              <span
                class="font-display text-3xl tabular-nums"
                style="color: var(--accent);"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <p
                class="text-xs tracking-[0.18em] uppercase mt-2"
                style="color: var(--text-soft);"
              >
                {section.label}
              </p>
            </div>
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li class="flex gap-3 text-base md:text-lg leading-relaxed">
                  <span
                    aria-hidden="true"
                    class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full"
                    style="background: var(--accent);"
                  ></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <hr class="rule mt-14 mb-8" />

    <Card variant="subtle" padding="lg">
      <p class="eyebrow mb-2">Stale?</p>
      <p class="text-sm leading-relaxed" style="color: var(--text-soft)">
        If this page hasn't been updated in over three months, ping me — chances are
        my real life has moved on and I just haven't written it down yet.
      </p>
    </Card>
  </Container>
</BaseLayout>
