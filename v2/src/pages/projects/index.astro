---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");
const sorted = projects.sort((a, b) => a.data.order - b.data.order);

// Collect unique tags + counts
const tagCounts = new Map<string, number>();
for (const project of sorted) {
  for (const tag of project.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tagLabels: Record<string, string> = {
  astro: "Astro",
  tailwind: "Tailwind",
  typescript: "TypeScript",
  javascript: "JavaScript",
  php: "PHP",
  mysql: "MySQL",
  bootstrap: "Bootstrap",
  html: "HTML",
  css: "CSS",
};

const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([id, count]) => ({ id, label: tagLabels[id] ?? id, count }));
---

<BaseLayout
  title="Projects — Todor Aleksandrov"
  description="Things I've built: an Android EV route planner, a four-person PHP/MySQL marketplace, this Astro portfolio and a hand-coded charity microsite. Filter by stack."
>
  <Container size="wide" class="py-(--spacing-section)">
    <SectionHeader
      eyebrow="Work"
      title="Projects"
      subtitle={`${sorted.length} projects so far — from a four-person CS4116 marketplace to the editorial portfolio you're reading.`}
      level={1}
      rule
    />

    <h2 class="sr-only">All projects</h2>

    <!-- TAG FILTERS -->
    <div
      class="mt-12 mb-10 flex flex-wrap items-center gap-2"
      role="group"
      aria-label="Filter by tag"
    >
      <button
        type="button"
        aria-pressed="true"
        class="proj-tag-btn active inline-flex items-center min-h-10 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase border transition-all"
        data-tag="all"
        style="border-color: var(--accent); background: var(--accent); color: var(--on-accent, #FAF6F0);"
      >
        All <span class="font-mono ml-1">{sorted.length}</span>
      </button>
      {allTags.map((tag) => (
        <button
          type="button"
          class="proj-tag-btn inline-flex items-center min-h-10 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase border transition-all"
          data-tag={tag.id}
          aria-pressed="false"
          style="border-color: var(--field-border, color-mix(in oklab, var(--text) 45%, transparent)); color: var(--text-soft);"
        >
          {tag.label} <span class="font-mono ml-1" style="color: var(--text-soft);">{tag.count}</span>
        </button>
      ))}
    </div>

    <!-- PROJECT GRID -->
    <div
      id="proj-grid"
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      {sorted.map((project) => (
        <div
          class="proj-cell"
          data-tags={project.data.tags.join(",")}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <p
      id="proj-empty"
      hidden
      role="status"
      class="mt-10 text-sm text-center"
      style="color:var(--text-soft)"
    >
      No projects match this tag. Try another?
    </p>
  </Container>
</BaseLayout>

<style>
  .proj-tag-btn:not(.active):hover { border-color: var(--accent) !important; color: var(--accent) !important; }
</style>

<script>
  import { initChipGroup } from "../../scripts/filter-chips";

  const buttons = document.querySelectorAll<HTMLButtonElement>(".proj-tag-btn");
  const cells = document.querySelectorAll<HTMLElement>(".proj-cell");
  const empty = document.getElementById("proj-empty");

  initChipGroup(buttons, {
    activeStyle: {
      "border-color": "var(--accent)",
      background: "var(--accent)",
      color: "var(--on-accent, #FAF6F0)",
    },
    inactiveStyle: {
      "border-color": "var(--field-border, color-mix(in oklab, var(--text) 45%, transparent))",
      background: "transparent",
      color: "var(--text-soft)",
    },
    onChange(btn) {
      const tag = btn.dataset.tag ?? "all";
      let anyVisible = false;
      cells.forEach((cell) => {
        const tags = (cell.dataset.tags ?? "").split(",");
        const visible = tag === "all" || tags.includes(tag);
        cell.hidden = !visible;
        if (visible) anyVisible = true;
      });
      if (empty) empty.hidden = anyVisible;
    },
  });
</script>
