---
import { getCollection, render } from "astro:content";
import { SITE } from "../../lib/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import Tag from "../../components/Tag.astro";
import Picture from "../../components/Picture.astro";
import { breadcrumbs, clean, personId } from "../../lib/structured-data";
import manifest from "../../data/image-manifest.json";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: index > 0 ? sorted[index - 1] : sorted[sorted.length - 1],
      next: index < sorted.length - 1 ? sorted[index + 1] : sorted[0],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Portrait screenshots (phone captures) are shown whole on a soft surface
// instead of being cropped by the landscape hero box.
const heroDims = data.image
  ? (manifest as Record<string, { width: number; height: number }>)[data.image]
  : undefined;
const heroIsPortrait = !!heroDims && heroDims.height > heroDims.width * 1.2;

const metaDescription = (() => {
  if (data.tagline && data.tagline.length <= 160) return data.tagline;
  const d = data.description;
  if (d.length <= 155) return d;
  const cut = d.slice(0, 155);
  return cut.slice(0, cut.lastIndexOf(" ")).replace(/[\s,;:.\-–—]+$/, "") + "…";
})();

const _site = Astro.site ?? new URL(SITE.url);
const _url = new URL(Astro.url.pathname, _site).href;
const projectLd = clean({
  "@context": "https://schema.org",
  "@type": data.githubUrl ? "SoftwareSourceCode" : "CreativeWork",
  name: data.title,
  description: data.description,
  url: _url,
  codeRepository: data.githubUrl,
  programmingLanguage: data.githubUrl ? data.stack : undefined,
  keywords: [...data.tags, ...data.stack].join(", "),
  author: { "@id": personId(_site) },
  image: data.image ? new URL(`/assets/${data.image.replace(/^\/?assets\//, "").replace(/^\//, "")}`, _site).href : undefined,
});
const structuredData = [
  projectLd,
  breadcrumbs(
    [
      { name: "Home", path: "/" },
      { name: "Projects", path: "/projects/" },
      { name: data.title, path: Astro.url.pathname },
    ],
    _site,
  ),
];

const sections = [
  data.problem && { num: "01", label: "The problem", body: data.problem },
  data.approach && { num: "02", label: "The approach", body: data.approach },
  data.contribution && { num: "03", label: "My contribution", body: data.contribution },
  data.learnings && { num: "04", label: "What I learned", body: data.learnings },
].filter(Boolean) as { num: string; label: string; body: string }[];
---

<BaseLayout
  title={`${data.title} — Project · Todor Aleksandrov`}
  description={metaDescription}
  ogType="article"
  structuredData={structuredData}
>
  <Container size="narrow" class="pt-12 md:pt-16">
    <a
      href="/projects/"
      class="inline-flex items-center gap-2 text-sm tracking-wide hover:text-(--accent) transition-colors"
      style="color:var(--text-soft)"
    >
      <span aria-hidden="true">←</span> All projects
    </a>

    <!-- HEADER -->
    <header class="mt-10 space-y-5">
      <p class="eyebrow">Case study · {data.tagline}</p>
      <h1
        class="font-display tracking-[-0.03em]"
        style="font-size:clamp(2.75rem, 6vw, 5rem); line-height:1.02;"
      >
        {data.title}
      </h1>
      <p class="text-lg md:text-xl leading-relaxed max-w-2xl" style="color:var(--text-soft)">
        {data.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-2">
        {data.stack.map((tech) => <Tag>{tech}</Tag>)}
      </div>

      <div class="flex flex-wrap gap-3 pt-4">
        {data.liveUrl && (
          <Button href={data.liveUrl} target="_blank" arrow>Live demo</Button>
        )}
        {data.githubUrl && (
          <Button href={data.githubUrl} target="_blank" variant="outline">
            View source
          </Button>
        )}
      </div>
    </header>
  </Container>

  <!-- HERO IMAGE -->
  {data.image && (
    <Container size="wide" class="mt-12 md:mt-16">
      <div
        class:list={[
          "rounded-3xl overflow-hidden border",
          heroIsPortrait ? "flex justify-center py-6 md:py-8" : "aspect-[16/9]",
        ]}
        style="border-color: color-mix(in oklab, var(--text) 10%, transparent); background: color-mix(in oklab, var(--text) 4%, transparent);"
      >
        <Picture
          src={data.image}
          alt={data.title}
          sizes={heroIsPortrait ? "(min-width: 768px) 320px, 70vw" : "100vw"}
          loading="eager"
          fetchpriority={heroIsPortrait ? undefined : "high"}
          class={
            heroIsPortrait
              ? "h-auto max-h-[34rem] w-auto max-w-[70%] rounded-2xl border object-contain"
              : "w-full h-full object-cover"
          }
        />
      </div>
    </Container>
  )}

  <!-- NUMBERED SECTIONS -->
  <Container size="narrow" class="mt-16 md:mt-24 space-y-12 md:space-y-16">
    {sections.map((sec) => (
      <section class="grid md:grid-cols-[6rem_1fr] gap-4 md:gap-10">
        <p
          class="font-display text-3xl tracking-[-0.02em] tabular-nums"
          style="color:var(--accent)"
        >
          {sec.num}
        </p>
        <div>
          <h2 class="font-display text-2xl md:text-3xl tracking-[-0.01em] mb-3">
            {sec.label}
          </h2>
          <p
            class="text-base md:text-lg leading-relaxed"
            style="color:var(--text-soft)"
          >
            {sec.body}
          </p>
        </div>
      </section>
    ))}
  </Container>

  <!-- MARKDOWN BODY -->
  <Container size="narrow" class="mt-16 md:mt-24">
    <hr class="rule mb-12" />
    <div class="prose-content text-lg leading-relaxed space-y-6" style="color:var(--text-soft)">
      <Content />
    </div>
  </Container>

  <!-- PREV / NEXT NAVIGATION -->
  <Container size="wide" class="mt-24 mb-(--spacing-section)">
    <hr class="rule mb-10" />
    <nav
      aria-label="Project navigation"
      class="grid sm:grid-cols-2 gap-4"
    >
      <a
        href={`/projects/${prev.id}/`}
        class="group/nav rounded-2xl p-6 border hover:border-(--accent) transition-colors"
        style="border-color: color-mix(in oklab, var(--text) 10%, transparent);"
      >
        <p class="eyebrow mb-2">← Previous</p>
        <p class="font-display text-2xl tracking-[-0.01em] group-hover/nav:text-(--accent) transition-colors">
          {prev.data.title}
        </p>
        <p class="text-sm mt-1" style="color:var(--text-soft)">
          {prev.data.tagline}
        </p>
      </a>
      <a
        href={`/projects/${next.id}/`}
        class="group/nav rounded-2xl p-6 border text-right hover:border-(--accent) transition-colors"
        style="border-color: color-mix(in oklab, var(--text) 10%, transparent);"
      >
        <p class="eyebrow mb-2">Next →</p>
        <p class="font-display text-2xl tracking-[-0.01em] group-hover/nav:text-(--accent) transition-colors">
          {next.data.title}
        </p>
        <p class="text-sm mt-1" style="color:var(--text-soft)">
          {next.data.tagline}
        </p>
      </a>
    </nav>
  </Container>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .prose-content h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose-content p {
    margin-top: 0.75rem;
  }
  .prose-content a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 200ms ease;
  }
  .prose-content a:hover {
    text-decoration-color: var(--accent);
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-top: 0.75rem;
  }
  .prose-content code {
    background: color-mix(in oklab, var(--text) 7%, transparent);
    padding: 0.1em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
  .prose-content img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--text) 10%, transparent);
    margin-top: 1.5rem;
  }
  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  .screenshot-grid img {
    margin-top: 0;
    border-radius: 1.25rem;
    object-fit: cover;
    width: 100%;
    height: auto;
  }
  @media (max-width: 640px) {
    .screenshot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
