---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import { cvVariants, GENERAL_PDF, CV_PDFS } from "../../lib/cv";

const general = cvVariants.find((v) => v.id === "general")!;
const tailored = cvVariants.filter((v) => v.id !== "general");
---

<BaseLayout
  title="CV — Todor Aleksandrov"
  description="Curriculum vitae — read it online or download the PDF. Tailored views for software, wine & hospitality, and customer service."
>
  <Container size="wide" class="py-(--spacing-section)">
    <SectionHeader
      eyebrow="Curriculum Vitae"
      title="Pick your view"
      subtitle="One career, a few different angles. Read any version online, or download the designed general CV as a PDF. Every view, and its PDF, is generated from the same content as this site."
      level={1}
      rule
    />

    <div class="mt-8">
      <Button
        href={GENERAL_PDF}
        download
        ariaLabel="Download Todor Aleksandrov's general CV (PDF)"
      >Download PDF ↓</Button>
    </div>

    <!-- General CV — featured -->
    <Card variant="surface" padding="lg" class="mt-12">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow mb-2">General · {general.headline}</p>
          <h2 class="font-display text-2xl tracking-[-0.01em] mb-2">The full CV</h2>
          <p class="text-sm leading-relaxed" style="color: var(--text-soft)">{general.blurb}</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <Button href="/cv/general/" arrow>Read online</Button>
          <Button
            href={GENERAL_PDF}
            variant="outline"
            download
            ariaLabel="Download Todor Aleksandrov's general CV (PDF)"
          >Download PDF ↓</Button>
        </div>
      </div>
    </Card>

    <!-- Tailored views -->
    <p class="eyebrow mt-14 mb-5">Tailored for a role</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tailored.map((v) => (
        <Card variant="outline" padding="lg" hover href={`/cv/${v.id}/`} class="group">
          <div class="flex flex-col h-full">
            <p class="eyebrow mb-2">{v.label}</p>
            <h2 class="font-display text-xl tracking-[-0.01em] mb-2 group-hover:text-(--accent) transition-colors">
              {v.headline}
            </h2>
            <p class="text-sm leading-relaxed flex-1" style="color: var(--text-soft)">{v.blurb}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium" style="color: var(--accent)">
              Read online
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </div>
        </Card>
      ))}
    </div>

    <nav aria-label="CV PDF downloads" class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <span class="eyebrow">PDF</span>
      {cvVariants.map((v) => (
        <a
          href={CV_PDFS[v.id]}
          download
          aria-label={`Download ${v.label} CV (PDF)`}
          class="inline-flex items-center min-h-10 font-medium hover:underline"
          style="color: var(--accent)"
        >{v.label} ↓</a>
      ))}
    </nav>

    <p class="mt-6 text-sm" style="color: var(--text-soft)">
      Each view has a downloadable PDF, generated from the same content as this site.
    </p>
  </Container>
</BaseLayout>
